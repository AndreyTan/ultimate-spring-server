
type User {
    id: ID!
    name: String!
    email: String!
    createdAt: String!
    orders: [Order!]!
}

type Product {
    id: ID!
    name: String!
    price: Float!
    stock: Int!
    createdAt: String!
}

type Order {
    id: ID!
    userId: ID!
    productId: ID!
    quantity: Int!
    orderDate: String!
    status: String!
    user: User!
    product: Product!
}

# Входные типы для мутаций
input UserInput {
    name: String!
    email: String!
}

input ProductInput {
    name: String!
    price: Float!
    stock: Int!
}

input OrderInput {
    userId: ID!
    productId: ID!
    quantity: Int!
}

# Корневые типы
type Query {
    # Users
    users: [User!]!
    user(id: ID!): User

    # Products
    products: [Product!]!
    product(id: ID!): Product

    # Orders
    orders: [Order!]!
    order(id: ID!): Order
    ordersByUser(userId: ID!): [Order!]!
    ordersByProduct(productId: ID!): [Order!]!
}

type Mutation {
    # Users
    createUser(input: UserInput!): User!
    updateUser(id: ID!, input: UserInput!): User!
    deleteUser(id: ID!): Boolean!

    # Products
    createProduct(input: ProductInput!): Product!
    updateProduct(id: ID!, input: ProductInput!): Product!
    deleteProduct(id: ID!): Boolean!

    # Orders
    createOrder(input: OrderInput!): Order!
    updateOrderStatus(id: ID!, status: String!): Order!
    cancelOrder(id: ID!): Boolean!
}